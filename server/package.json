{
  "name": "@uchiro/server",
  "version": "3.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src -e ts --exec ts-node src/server.ts",
    "dev:bots": "nodemon --watch src -e ts --exec ts-node src/run-bots.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:production": "node dist/production.js",
    "start:bots": "node dist/run-bots.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --fileParallelism=false",
    "test:sample-delivery": "ts-node src/scripts/test-sample-delivery.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
