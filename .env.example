# ==============================================================================
# UCHIRO STORE V3 - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual production/staging values.
# IMPORTANT: Never commit actual secret keys or credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Server
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL - Persistent Storage)
# On Railway, adding a PostgreSQL database will automatically set DATABASE_URL.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/uchiro_store

# (Optional: Supabase if using Supabase database instead of raw PostgreSQL)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 3. Security & Cryptography
# JWT_SECRET: Minimum 32 random characters for signing customer JWT tokens.
# ENCRYPTION_KEY: 64-char hex string (32 bytes) used for encrypting delivery credentials.
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secure_jwt_secret_min_32_characters_long
ADMIN_JWT_SECRET=your_super_secure_admin_jwt_secret_min_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. Telegram Bots
# STORE_BOT: Customer-facing store bot (@UchiroStore_BOT)
# ADMIN_BOT: Internal management bot (@uchiro_v2_admin_bot)
# ADMIN_TELEGRAM_IDS: Comma-separated list of Telegram User IDs who have admin access.
# ------------------------------------------------------------------------------
STORE_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
STORE_BOT_USERNAME=UchiroStore_BOT
ADMIN_BOT_TOKEN=987654321:ZYXwvuTSRqpoNMLkjiHGFedcba
ADMIN_BOT_USERNAME=uchiro_v2_admin_bot
ADMIN_TELEGRAM_IDS=123456789,987654321
STORE_WEBHOOK_SECRET=uchiro_store_webhook_secret_key_v3
ADMIN_WEBHOOK_SECRET=uchiro_admin_webhook_secret_key_v3
TELEGRAM_CHANNEL_USERNAME=UchiroStore
TELEGRAM_SUPPORT_USERNAME=UchiroSupport

# ------------------------------------------------------------------------------
# 5. Public URLs & Domains (Must be HTTPS in Production for Telegram Mini Apps)
# ------------------------------------------------------------------------------
SERVER_URL=https://your-production-domain.up.railway.app
STORE_URL=https://your-production-domain.up.railway.app
# If hosted on separate frontend domain:
# CLIENT_STORE_URL=https://store.yourdomain.com
# CLIENT_ADMIN_URL=https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 6. Admin Portal Stealth & Security Gate
# ADMIN_SECRET_SLUG: Hidden path segment for web admin (e.g. /noreakyoutadmindashboard)
# ADMIN_SECRET_PIN: Secret numeric or alphanumeric PIN for entering admin dashboard
# ADMIN_SESSION_SECRET: Minimum 32 chars HMAC secret for admin dashboard sessions
# ------------------------------------------------------------------------------
ADMIN_SECRET_SLUG=noreakyoutadmindashboard
ADMIN_SECRET_PIN=your_super_secret_admin_pin
ADMIN_SESSION_SECRET=your_admin_session_hmac_secret_min_32_chars

# ------------------------------------------------------------------------------
# 7. KHPay Payment Gateway (KHQR / Bakong)
# ------------------------------------------------------------------------------
KHPAY_BASE_URL=https://khpay.site/api/v1
KHPAY_API_KEY=your_khpay_api_key_here
KHPAY_WEBHOOK_SECRET=your_khpay_webhook_secret_signature
KHPAY_CURRENCY=USD
KHPAY_EXPIRY_MINUTES=10
KHPAY_TEST_MODE=false

# ------------------------------------------------------------------------------
# 8. Roblox API (Optional - for player avatar, inventory & profile verification)
# ------------------------------------------------------------------------------
ROBLOX_COOKIE=
ROBLOX_API_BASE=https://users.roblox.com
ROBLOX_THUMBNAILS_API=https://thumbnails.roblox.com

# ------------------------------------------------------------------------------
# 9. CORS & Rate Limiting (Optional)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://web.telegram.org
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
